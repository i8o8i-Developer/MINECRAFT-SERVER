# ===============================================================
#  Durgaai Solutions Minecraft Server — Environment Variable Template
#  Copy This To .env For Local Testing Only.
#  In Coolify, Set These Via The Environment Variables User Interface Tab.
#  Never Commit Your Real .env To Git Hub.
# ===============================================================

# -- Minecraft --------------------------------------------------
PORT=25565
MINECRAFT_VERSION=1.21.10
MINECRAFT_GAME_MODE=survival
MINECRAFT_DIFFICULTY=normal
MINECRAFT_ONLINE_MODE=true
MINECRAFT_INIT_MEMORY=8G
MINECRAFT_MAX_MEMORY=8G

# -- Rcon (Strong Random Password!) -----------------------------
# Generate One: openssl rand -base64 32
SERVICE_PASSWORD_RCON=ChangeMeStrongPassword

# -- Rcon Web Dashboard -----------------------------------------
RCON_WEB_USER=Admin
RCON_WEB_PASS=ChangeMeStrongPassword

# File Browser login (Configured Directly in docker-compose.yml)
# Username: i8o8i
# Password: i8o8i
